# .env
HTTPS=true
SSL_CRT_FILE=./cert.pem
SSL_KEY_FILE=./key.pem






# Session Duration - 8 hours 15 minutes
VITE_SESSION_DAYS=0
VITE_SESSION_HOURS=1
VITE_SESSION_MINUTES=15

# Warning - 15 minutes before expiry
VITE_SESSION_WARNING_DAYS=0
VITE_SESSION_WARNING_HOURS=0
VITE_SESSION_WARNING_MINUTES=3